            <Id>0b01e41080032066</Id>
            <NaamInDscCatalogus xsi:nil="true" />
            <UniekeNaam>Aantal beschikbare gestelde uren, fase 1+2</UniekeNaam>
            <Definitie>Aantal niet nader gespecificeerde uren van de door een bedrijf beschikbaar gestelde arbeidskrachten volgens de uitzendovereenkomst 'voor de duur van de opdracht'.</Definitie>
            <Variabelengroeppad xsi:nil="true" />
            <Objecttypenaam xsi:nil="true" />
            <Waardestelselnaam xsi:nil="true" />
            <WaardestelselIsClassificatie xsi:nil="true" />
            <Eigenaar xsi:nil="true" />
            <GeldigVanaf>2006-01-01</GeldigVanaf>
            <GeldigTot xsi:nil="true" />
            <Versie xsi:nil="true" />
