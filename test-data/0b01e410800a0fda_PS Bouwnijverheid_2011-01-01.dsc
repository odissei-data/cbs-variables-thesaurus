            <Versie xsi:nil="true" />
            <Themas xsi:nil="true" />
          </Variabele>
          <VerkorteSchrijfwijzeNaamVariabele>OUT_SBSVARI131100</VerkorteSchrijfwijzeNaamVariabele>
