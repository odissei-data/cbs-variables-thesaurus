    skos:narrower cbsVar:6ea165f43139b2be37e8a59350e71257c4a0b81001963b5adbf66ee970e0ef9e ;
    skos:prefLabel "Kosten ingeleend personeel_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea5e a skos:Concept ;
    skos:definition "Personeelskosten zoals kosten voor woon-werkverkeer, auto van de zaak, kinderopvang, kosten van stagiaires zonder loon, vrijwilligers, bestuursleden, freelancers, scholing, verbetering van arbeidsomstandigheden, werkkleding, vakliteratuur, leermiddelen en wervingskosten."@nl ;
