cbsVar:0b01e4108025c7ff a skos:Concept ;
    skos:definition "Het bedrag aan belastingen die periodiek over het eigendom of het gebruik van grond of gebouwen moet worden betaald door eigenaren, belastingen op het netto vermogen en op andere activa (juwelen, andere uiterlijke tekenen van rijkdom)."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a0b43d20ba3c750dabc47e8084e0e630eb3da91d48ef1a6a37f4f68fee6f3986 ;
