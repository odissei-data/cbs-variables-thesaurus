    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021443f a skos:Concept ;
    skos:definition "Uitkering sociale voorzieningen: Uitkering in het kader van de Wet investeren in jongeren (WIJ)"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:15170b8649e6b640e5d415570b41c9958e766af8c1ada4fd0e60828932925ded ;
    skos:prefLabel "Fiscaal bedrag uitkering in het kader van de Wet investeren in jongeren (WIJ)"@nl ;
