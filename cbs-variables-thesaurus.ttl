    skos:narrower cbsVar:35b5c7365ecf56b29b6b8b6e06628883822ace5f8fcb3e8a86a65fc23312c31e ;
    skos:prefLabel "Financiële bezittingen van overledene"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803abafb a skos:Concept ;
    skos:definition "De totale waarde aan tegoeden van een overledene op rekeningen bij (spaar)banken, inclusief buitenlandse tegoeden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a0581c26a9a4c303bae67098b23ce4bc39baa431de5fc3d5043befcb61b7a1ca ;
    skos:prefLabel "Bank- en spaartegoeden van overledene"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803abafc a skos:Concept ;
    skos:definition "Totale waarde van obligaties en aandelen van een overledene, exclusief aandelen aanmerkelijk belang."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:251b29144cac612ca9f45b6a4995cab043b64c89abf094fefab75b0f67a6c707 ;
    skos:prefLabel "Waarde effecten van overledene"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803abafd a skos:Concept ;
    skos:definition "De totale waarde van de eigen woning en overig onroerend goed van een overledene."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a2fc2d03c229bfd10a3addd22778f06e7c33fa06076cb247fb3c965b3a5e64d7 ;
    skos:prefLabel "Waarde onroerend goed van overledene"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803abafe a skos:Concept ;
    skos:definition "Waarde van de woning in eigendom van een overledene en in gebruik als hoofdverblijf."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:97a8051d94e5dac13755f3d26d5fa25e99e5e188579ebdfb170e730f686cd99b ;
    skos:prefLabel "Waarde eigen woning van overledene"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803abaff a skos:Concept ;
    skos:definition "Totale waarde van onroerend goed van de overledene, exclusief de woning die als hoofdverblijf dient. Het gaat bijvoorbeeld om een tweede woning, een vakantiehuis, beleggingspanden en dergelijke."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:79b7d1d2b0ce4a05ea96e359e8de69e460f6d1f4ae51079d611814e99d29672a ;
    skos:prefLabel "Waarde overig onroerend goed van overledene"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803abb00 a skos:Concept ;
    skos:definition "Het saldo van bezittingen en schulden behorend tot het bedrijfs- of beroepsvermogen van een overledene."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:83e4917bc948b0d814f863e2e0b2cf9dfbd666e8da9c9838bb49602bb04c3f56 ;
    skos:prefLabel "Ondernemingsvermogen van overledene"@nl ;
