cbsVar:0b01e41080209e21 a skos:Concept ;
    skos:definition "Indicator voor de imputatie van de postcode van het vertrekpunt."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ffba6d1f8d355a15d0c9ad4188769fa0f3ca7761469f077cae5fa72cbfea3095 ;
    skos:prefLabel "Indicator voor imputatie postcode vertrekpunt"@nl ;
    skos:topConceptOf cbsVar: .

