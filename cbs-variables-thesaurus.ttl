    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:4f05c900507bedc8987801f9424b1f7ddbde5489ec4b126dbe77dd8571fe0c56 ;
    skos:prefLabel "Schulden aan kredietinstellingen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036117b a skos:Concept ;
    skos:definition "Schulden uit hoofde van financieringsoverschot, transitieregeling medisch specialistische zorg, honorariumplafond en macrobeheersinstrument."@nl ;
