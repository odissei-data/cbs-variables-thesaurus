    skos:prefLabel "Pachtinkomsten winkel"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea22 a skos:Concept ;
    skos:definition "Inkomsten uit speciale evenementen en/of incidentele (avond)openstelling"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d9e6ab701371b46393edb3d9328eedd7d17010359b58491a3e58c11d9fb31df6 ;
