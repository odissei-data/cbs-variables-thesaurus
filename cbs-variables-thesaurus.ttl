    skos:prefLabel "Sponsoring"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea1e a skos:Concept ;
    skos:definition "Opbrengst van de verkoop van dranken, snacks, en dergelijke in musea inclusief opbrengsten van horeca-arrangementen, partyservice en dergelijke"@nl ;
