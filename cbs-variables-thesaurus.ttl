    skos:prefLabel "Duur wil werk"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080378150 a skos:Concept ;
    skos:definition "De gebruiksoppervlakte van een huurwoning volgens het Basisregistratie Adressen en Gebouwen (BAG)-register."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:bc90dea910b6cf9fffbd49c1da78c4205cea80b531f4aeb7c748855d97d3a90b ;
    skos:prefLabel "Gebruiksoppervlakte huurwoning volgens BAG-register"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108037a645 a skos:Concept ;
    skos:definition "De voornaamste reden waarom een persoon geen ouderschapsverlof heeft opgenomen."@nl ;
