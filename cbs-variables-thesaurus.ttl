    skos:narrower cbsVar:476ab590758671d2fc147b970b713a8f40254aba486d57c6be09827707d5294f ;
    skos:prefLabel "Loonaangifte: Totaal fiscaal loon of uitkering"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021407b a skos:Concept ;
    skos:definition "Totaal ingehouden heffing loonbelasting en premie volksverzekeringen zoals waargenomen in de loonaangifte. Ook uitkeringen die onder de loonbelasting vallen, zijn hierin opgenomen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:c23486ceadb8b95e5873c7b50d5e420908cb148e2dd02429b3e50bd7c1fa07fd ;
    skos:prefLabel "Loonaangifte: Totaal loonbelasting en premie volksverzekeringen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021407c a skos:Concept ;
    skos:definition "Het bedrag dat de werkgever aan de werknemer verstrekt als bijdrage aan de kosten voor kinderopvang, zoals waargenomen in de loonaangifte."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0264848d48f7451fbed39c6a8937ddc18c4026bec792aca0e63f35a3747e0809 ;
    skos:prefLabel "Loonaangifte: Werkgeversbijdrage voor kinderopvang"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021407e a skos:Concept ;
    skos:definition "Een codecijfer dat per gezin is toegekend. Aan personen die tot eenzelfde gezin behoren is eenzelfde code toegekend. Aan personen die niet tot een gezin behoren is de code 0 toegekend."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:493a4b0d5e507ea27414c40b953af1aae1a0bd8eb070f61d005e66954cb3f5c8 ;
