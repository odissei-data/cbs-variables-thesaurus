cbsVar:0b01e4108020ea7c a skos:Concept ;
    skos:definition "Kosten voor restauratie van museumstukken."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:8788976deb4c98841e0b815a215b6362035032f57bb33d41436cad9a7b8119d9 ;
