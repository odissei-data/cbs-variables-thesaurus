    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ac52 a skos:Concept ;
    skos:definition "De gemiddelde hoeveelheid BZV die per dag per kilogram actieve bacteriemassa (ofwel 'actief slib') wordt aangevoerd in het bassin waarin de biologische zuivering plaatsvindt."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:90250aa5ed226dddf4a89eb5d2eebb946ea3113037436c5671df45c8d10cdfca ;
    skos:prefLabel "Slibbelasting Biologisch Zuurstofverbruik"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ac53 a skos:Concept ;
    skos:definition "De Slib Volume Index geeft informatie over de bezinkeigenschappen van het actieve zuiveringsslib. De index wordt uitgedrukt als het volume in ml wat een gram zuiveringsslib innneemt na een bezinktijd van een uur. Een waarde lager dan 150 geeft aan dat het slib goed bezinkbaar is."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:837382172d95bee34b7ff1d3de48ab2392b74589a0a221d464ad3b436a96cc5c ;
    skos:prefLabel "Slib Volume Index"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ac54 a skos:Concept ;
    skos:definition "De gemiddelde concentratie van zuiveringsslib in de bassins waar de biologische zuivering plaatsvindt, uitgedrukt als kilogram droge stof per m3 bassin."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9828421d3d4faf9990bdb0176f0ff7da44f25491455ab54ffc797554c53197e8 ;
    skos:prefLabel "Slibconcentratie in het beluchtingsbassin"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ac55 a skos:Concept ;
    skos:definition "De hoeveelheid zuiveringsslib, uitgedrukt als droge stof, die gemiddeld per dag als surplus wordt afgevoerd uit de beluchtingsbassins van de rioolwaterzuiveringsinstallatie."@nl ;
