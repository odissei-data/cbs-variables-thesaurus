cbsVar:0b01e41080214436 a skos:Concept ;
    skos:definition "Ontvangen gebonden uitkeringen: Tegemoetkoming voor minderjarige scholieren in het kader van de wet tegemoetkoming onderwijsbijdrage en schoolkosten (WTOS)"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:67a46aa32c98a7ebb352981968f3dd85c67d3bb9c7ffc4a8f744b6d957214f29 ;
    skos:prefLabel "Tegemoetkoming voor minderjarige scholieren (WTOS)"@nl ;
    skos:topConceptOf cbsVar: .

