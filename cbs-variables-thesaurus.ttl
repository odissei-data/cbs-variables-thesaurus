    skos:prefLabel "Inkopen van handelsgoederen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080029099 a skos:Concept ;
    skos:definition "Gemiddeld aantal Wet Sociale Werkvoorziening (WSW)- werknemers welke zijn uitgeleend (de werknemers staan onder het gezag van het uitlenende bedrijf)."@nl ;
    skos:inScheme cbsVar: ;
