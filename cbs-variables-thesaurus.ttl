cbsVar:0b01e4108021410d a skos:Concept ;
    skos:definition "WOZ-waarde eigen woning volgens de aangifte inkomstenbelasting. De WOZ-waarde wordt vastgesteld in het kader van de Wet Waardering Onroerende Zaken (WOZ)."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9cd19b69fa6296d7993dd7b3dc1776fe6756eebe23f5e802da43ab7ed7ac1225 ;
