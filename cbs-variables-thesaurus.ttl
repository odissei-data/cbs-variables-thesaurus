cbsVar:0b01e41080209e1d a skos:Concept ;
    skos:definition "Hoofdvervoermiddel van een beroepsmatige verplaatsing van een persoon. Beroepsmatige verplaatsingen worden gemaakt door bijvoorbeeld pakketbezorgers, taxichauffeurs et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:07e9dda514dfdf264e9206c66d006130d1f15ee3afe18faa0c84e673aed727ea ;
    skos:prefLabel "Hoofdvervoermiddel beroepsmatige verplaatsing"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209e1e a skos:Concept ;
    skos:definition "Variabele geeft aan of het hoofdvervoermiddel een fiets is en zo ja, elektrisch of niet. Beroepsmatige verplaatsingen worden gemaakt door bijvoorbeeld pakketbezorgers, taxichauffeurs et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:61551ff1c59e98f9ab3b5e948bcb7b4009c80749c43be55a0a21a473ce60c544 ;
