cbsVar:0b01e41080213f30 a skos:Concept ;
    skos:definition """Afbakening van kans op armoede:

Het wettelijk bestaansminimum zoals dat in de politieke besluitvorming is vastgesteld."""@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:fc40008c1be405c00c9faf4290295d32b2767b5f56c88f6ab074d903a0f6e16d ;
    skos:prefLabel "Beleidsmatig minimum (normbedrag)"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080213f31 a skos:Concept ;
    skos:definition "Het bruto-inkomen bestaat uit het primair inkomen (inkomen uit arbeid, onderneming en vermogen) verhoogd met: -uitkeringen inkomensverzekering voor werkloosheid, arbeidsongeschiktheid, pensioen en nabestaandenpensioen. Dit zijn uitkeringen zoals uitkering ingevolge de WW/nWW (werkloosheidswet), de WAO (Wet op de arbeidsongeschiktheidsverzekering), de WIA (Wet werk en inkomen naar arbeidsvermogen) en de AOW (Algemene Ouderdomswet), -uitkeringen sociale voorziening zoals de algemene bijstandsuitkering (ABW, vanaf 2004 WWB), -gebonden overdrachten voor wonen en studie zoals huursubsidie (vanaf 2006 huurtoeslag) en tegemoetkoming studiekosten, en -ontvangen inkomensoverdrachten zoals alimentatie van de ex-echtgeno(o)t(e). Het weergegeven bedrag is inclusief de bijdragen van werknemers, werkgevers, uitkeringsontvangers en uitkeringsinstanties in de premies voor de sociale verzekeringen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b79b1db6f792296345724329d94ab59c7828ba17edfc77f3b6b3a27de77c3609 ;
    skos:prefLabel "Bruto inkomen van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080213f4b a skos:Concept ;
    skos:definition "Combinatie van ophoging en herweging naar bevolkingstotalen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:dea1f9785df6f77e5bd40393938d6e6f5155f4b4442b5d47b990794dad68a4f3 ;
    skos:prefLabel "Ophooggewicht van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

