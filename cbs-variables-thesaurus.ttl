    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209e20 a skos:Concept ;
    skos:definition "De indicator voor de imputatie van de verplaatsingsafstand geeft aan of de responsafstand ontbrak of dat de afstand bepaald is bij de imputatie van een terug naar-huis verplaatsing."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9acd16cf5d3a4f5f4fe274d4d4934c69228d1d7ae550ff1a906a6f2c1c80e139 ;
