cbsVar:0b01e41080214439 a skos:Concept ;
    skos:definition "Inkomen uit aanmerkelijk belang. De som van reguliere voordelen uit aanmerkelijk belang (na aftrek kosten) en vervreemdingsvoordeel. Het totaal is afgekapt op een kwart miljoen euro."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:6037df6963d860aefac9864f8b65232a6f43041ee7b1d99e58e58dacb1b17f59 ;
    skos:prefLabel "Inkomen uit aanmerkelijk belang"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021443a a skos:Concept ;
    skos:definition "Hulpvariabele: Fiscaal bedrag Uitkering wachtgeld"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:614bf124676432ea42a0a18b9f54e16673fe97cab80a7f77936b8e19e825d35c ;
    skos:prefLabel "Uitkering inkomensverzekeringen: Fiscaal bedrag Uitkering wachtgeld"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021443b a skos:Concept ;
