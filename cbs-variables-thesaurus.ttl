cbsVar:0b01e41080028fa4 a skos:Concept ;
    skos:definition """Gemiddeld aantal ingeleend personeel. 
Van in- en uitlenen is sprake indien de betrokken werknemers rechtstreeks onder gezag staan van het in- of uitlenende bedrijf. In andere gevallen, zoals accountants- en automatiseringsdiensten, is er sprake van hulpdiensten en geen sprake van inlening van personeel."""@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:4f43e4ccfcabb2e051c0d53e2fd517ae34b8c2f4573b9acfe45f06b6137e87e8 ;
    skos:prefLabel "Gemiddeld aantal ingeleend personeel"@nl ;
    skos:topConceptOf cbsVar: .

