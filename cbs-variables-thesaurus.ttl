    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea24 a skos:Concept ;
    skos:definition "Inkomsten uit bruikleenverkeer"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1e3dfbdc1c99ff382eb0739444219f831dbe593e67630ea2786761f908732a21 ;
    skos:prefLabel "Opbrengst bruikleenverkeer"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea3e a skos:Concept ;
    skos:definition "Tegemoetkoming van de overheid in de loonkosten van een bedrijf, gebaseerd op de Wet terugdringing arbeidsongeschiktheidsvolume (TAV)."@nl ;
