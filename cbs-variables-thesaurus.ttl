    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803d4906 a skos:Concept ;
    skos:definition "Duidt een zorgaanbieder, zorgactor aan. Een zorgaanbieder is een zelfstandige organisatorische eenheid of groep van zelfstandige organisatorische eenheden, die economische activiteiten uitoefent met zorg als doel."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2da3a99e4300a08da7d3d1b6b54abb945f671e06cec56f56cdcea9e14a436d93 ;
    skos:prefLabel "Zorgaanbieder"@nl ;
    skos:topConceptOf cbsVar: .

