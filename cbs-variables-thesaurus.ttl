cbsVar:0b01e41080214454 a skos:Concept ;
    skos:definition "Winst uit medegerechtigdheid. Je bent medegerechtigde in een onderneming als je bijvoorbeeld commanditaire vennoot bent in een commanditair vennootschap (CV)."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:50afa59e29cd8f19ea5d6a5b2c0b3593940433869b3aa5b5929573870d542b17 ;
    skos:prefLabel "Winst uit medegerechtigdheid"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214455 a skos:Concept ;
    skos:definition "Winst uit onderneming voor aftrek ondernemersaftrek en MKB (Midden- en kleinbedrijf)-winstvrijstelling en inclusief de winst uit medegerechtigdheid. Het winstbedrag is afgekapt, zodanig dat winst en investeringsaftrek samen niet te extreem zijn."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b1604054a2bf2fd1a775168e727dfd1ecb9b8009de52f7db36783ce30c7fa281 ;
    skos:prefLabel "Inkomen uit onderneming"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214456 a skos:Concept ;
    skos:definition "Hulpvariabele: Fiscaal bedrag uitkering Ziektewet (ZW)"@nl ;
