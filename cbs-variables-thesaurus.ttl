    skos:narrower cbsVar:dc02ccba6e2d59ab2e90b724bc174f45f1e9fa2c23467e28cb5c511153b6cfa8 ;
    skos:prefLabel "Opbrengsten Jeugdwet"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361137 a skos:Concept ;
    skos:definition "Opbrengsten uit geleverde diensten (met uitzondering van zorg), zoals onder andere onderzoek (vooral door Universitair Medisch Centrum (UMC's)), catering, bereide maaltijden voor andere zorginstellingen, winkelverkoop, parkeergelden, verkoop/verhuur van hulpmiddelen, verlenen van gemak diensten en het geven van cursussen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:880715cd349cdeb7fde22647a6ff1d9214623ada1568339425da64dd4bad93f6 ;
    skos:prefLabel "Opbrengsten uit overige dienstverlening"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361138 a skos:Concept ;
    skos:definition "Betalingen 'om niet' die door de overheid of de Instellingen van de Europese Unie worden gedaan aan ingezeten producenten, met het doel de productieniveaus, de prijzen of de beloning van de productiefactoren te beïnvloeden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:dd453d0973e8511c490b035cd1ce09c18f9e352332665a0ac4054c12691561d0 ;
    skos:prefLabel "Subsidies"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361139 a skos:Concept ;
    skos:definition "De kosten die zijn gemaakt om de bedrijfsopbrengsten te realiseren, te weten de inkoopwaarde van de omzet, de arbeidskosten, de afschrijvingen op vaste activa en de zogenaamde overige bedrijfskosten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a5689b706732209bf6037047e2bbc05de3025d36a666979e070f315da0a0cce5 ;
    skos:prefLabel "Bedrijfskosten_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036113a a skos:Concept ;
    skos:definition "De vergoedingen voor de werknemer, die in een bepaalde periode arbeid verricht, en die ten laste komen van de werkgever, inclusief de door de werkgever ingehouden loonbelasting en de sociale premies die ten laste komen van de werknemer."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:71e80d33f5427cfff350a787026875d16e12d6b6a05d0d30bc845ecf41909eaf ;
    skos:prefLabel "Lonen en salarissen_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036113b a skos:Concept ;
    skos:definition """Werkgeversaandeel pensioenlasten, sociale voorzieningen en overige sociale lasten. 
De sociale lasten zijn de werkgeversbijdragen in het kader van de sociale zekerheid. Deze omvatten de toegerekende en werkelijke sociale premies en de werkelijke pensioenpremies."""@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:beeffa25c703af1f8785541d68de8cab3c8ba1bfec67c6ad233abf953d28e0d6 ;
    skos:prefLabel "Pensioenlasten en sociale lasten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036113c a skos:Concept ;
    skos:definition "Honorariumkosten van vrijgevestigd medisch specialisten die aan een instelling voor medisch specialistische zorg declareren."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9b4f0f0b0ea16757c0850fce24148fb5c1716448d50ca272ba9211e8f4d7504e ;
    skos:prefLabel "Honorariumkosten vrijgevestigd medisch specialisten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036113e a skos:Concept ;
    skos:definition "Bijzondere waardeverminderingen zich voordoen waarbij wordt vastgesteld dat de reële waarde van een actief lager is dan de boekwaarde. Daarnaast kunnen bijzondere waardeverminderingen voorkomen bij vaste activa waarop niet wordt afgeschreven en bij financiële vaste activa."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ca3be0807cf654d4c49239f5edf9141008bc57985d592c2809bc695ac6ab9b4d ;
    skos:prefLabel "Bijzondere waardeverminderingen mutatieoverzicht materiele vaste activa"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361157 a skos:Concept ;
    skos:definition "Kosten werving en selectie, opleiding, kleding, kinderopvang en dergelijke voor personeel."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ae9cca61f8cca41d8a3593e713151b990e1201d895357a66ed89610db84be8ae ;
    skos:prefLabel "Niet eerder genoemde personeelskosten_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361158 a skos:Concept ;
    skos:definition "Kosten van maaltijdverstrekkingen (voeding) en hotelmatige kosten zoals kosten van huishouding, linnenvoorziening en vervoer van cliënten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:bf37c1351db0b8729870ebb2fb71e6eb678ccf4b01eefa37a90deb9969384f48 ;
    skos:prefLabel "Voeding en hotelmatige kosten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361159 a skos:Concept ;
    skos:definition "De bedrijfsopbrengsten minus de bedrijfslasten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:75e56dc47cefe71ea80a6b08f597efa3957538765f33120e7ad88fb2bfe9d560 ;
    skos:prefLabel "Bedrijfsresultaat_n03"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036115a a skos:Concept ;
    skos:definition "De rentebaten, de winst uit deelnemingen, ontvangen dividenden, winst op beleggingen en overige financiële baten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:441ca6174b3ffdacb1c610f27ce6bebe17d878f4b357048db21de8818aed37fd ;
    skos:prefLabel "Financiële baten_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036115b a skos:Concept ;
    skos:definition "Het saldo van rentebaten en -lasten, baten en lasten uit deelnemingen, ontvangen dividenden, kosten van leningen, winst en verlies op beleggingen en overige financiële baten en lasten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:af94962b9a46b3a3fca199f4ee943c50b6b95113d29796bfdcfd50ca29e79516 ;
    skos:prefLabel "Financieel resultaat_n03"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036115e a skos:Concept ;
    skos:definition "Vaste activa die betrekking hebben op financiële kapitaalgoederen zoals deelnemingen in andere ondernemingen, beleggingen in vastgoed of effecten, hypotheken, leningen op schuldbekentenis, bancaire kredietverlening, en zaken als vorderingen die op lange termijn aan derden (anders dan uit hoofde van een kapitaaldeelneming) ter beschikking zijn gesteld."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b19093812461dc2a611199a0442de7c294a7fffaa71b7c47102a061bc9c79090 ;
    skos:prefLabel "Financiële vaste activa"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036115f a skos:Concept ;
    skos:definition "Financieren van (deelname in het kapitaal) een andere onderneming om daarmee invloed uit te kunnen oefenen in het beleid van die onderneming"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:c630c7222e316203dadbd84b381d74fc084cb7aa57ddc8c9897bc3facd99528a ;
    skos:prefLabel "Deelnemingen_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080361177 a skos:Concept ;
    skos:definition "Vorderingen uit hoofde van financieringstekort en transitieregeling medisch specialistische zorg."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a0a24be19a0d067385fa60fdc7b6409676a488f273dccb9323a0e09129e23f56 ;
    skos:prefLabel "Vorderingen uit hoofde van bekostiging_n02"@nl ;
    skos:topConceptOf cbsVar: .

