    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203e5 a skos:Concept ;
    skos:definition "Betalingen voor de afvoer en/of verwerking van overig vast afval, waaronder slib, mest, radio-actief afval, kantoor- en kantine-afval"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b7976b7b205262bb2153702b03382e374685fd9a00a60b5ab480a11dfff5f5a9 ;
    skos:prefLabel "Betalingen voor afvoer en verwerking van overig vast afval"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203e6 a skos:Concept ;
    skos:definition "Betalingen voor waterzuivering door particulieren, milieuonderzoek en milieucoördinatie, milieuschade en milieuboeten"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d65d4e01d77161f2c55443465e9ca09e38b887865406ba64ae4d76c075be3b16 ;
    skos:prefLabel "Betalingen voor uitbestede milieuactiviteiten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203e7 a skos:Concept ;
    skos:definition "Ontvangen overdrachten: subsidiëring van milieu-investeringen door de overheid waardoor het treffen van milieumaatregelen wordt gestimuleerd."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:00898522e49f772f22650b6eaca99ad38726934f1e13e258f4ee75301fc74f16 ;
    skos:prefLabel "Ontvangen milieusubsidies"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203e9 a skos:Concept ;
    skos:definition "Milieu-investeringen ter voorkoming of beperking van aantasting van natuur en landschap. Voorbeelden: groengordels en aarden wallen, vereist rond fabrieks- of industrieterrein; herinrichting van het landschap (bijvoorbeeld bij afgravingen); zichtbaar maken van hoogspanningslijnen ter voorkoming van vogelaanvaring; apparatuur voor lozings- en concentratiemetingen; maatregelen ter beperking van grondwatergebruik, et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:55367767e453365ce44774a010c24b66524f6f19d43de0b649d8c4c306fe2ed9 ;
    skos:prefLabel "Milieu-investeringen tegen aantasting van natuur en landschap"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203fe a skos:Concept ;
    skos:definition "Milieu-investeringen om bodemverontreiniging te voorkomen of te beperken. Voorbeelden: vloeistofdichte isolatie van bodem met opstaande randen of dijken, met bijbehorende drainagesystemen, pompen, leidingen en verzamelbekkens; voorzieningen voor opvang van mors- en lekverliezen; voorzieningen aan ondergrondse opslagvaten en leidingen; apparatuur voor emissie- en concentratiemetingen, et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0fbda6586ff1837b46c59b1b8c9462bce10672000915d77a66bd677c313e7c38 ;
    skos:prefLabel "Milieu-investeringen tegen bodemverontreiniging"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203ff a skos:Concept ;
    skos:definition "Milieu-investeringen om geluidshinder te voorkomen of te beperken. Voorbeelden: omkasting of akoestische isolatie van machines en leidingen; dempers; geluidsschermen of -wallen; apparatuur voor geluidsmetingen; trillingdempende funderingen; geluidsarme branders op fakkels, et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0eae3aa051812b259a668988dc703e134d457043fb5fb9fa5776e1ce373fe769 ;
    skos:prefLabel "Milieu-investeringen tegen geluidshinder"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080020400 a skos:Concept ;
    skos:definition "Milieu-investeringen ter voorkoming of beperking van het ontstaan van afvalstoffen. Voorbeelden: voorzieningen voor opslag, transport en behandeling van afval in eigen beheer, bijvoorbeeld eigen containers en voertuigen; voorzieningen die afval sorteren, scheiden, comprimeren, composteren, vergisten; toepassing van duurdere (productie)processen, et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:401f0f58c049afd822c1c3af3b5516a0440f17502925ecf07ee1232d4398681b ;
    skos:prefLabel "Milieu-investeringen tegen het ontstaan van afval"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080020401 a skos:Concept ;
    skos:definition "Milieu-investeringen om luchtverontreiniging te voorkomen of te beperken. Voorbeelden: installaties en dergelijke om afvalgassen te zuiveren, te beperken of te voorkomen; voorzieningen die zorgen voor een betere verspreiding van luchtverontreinigende stoffen in de atmosfeer (bijvoorbeeld verhoging van bestaande schoorstenen); fakkelsystemen; apparatuur voor emissie-, stank- en concentratiemetingen buiten gebouwen; isolatie van gebouwen en installaties; installaties voor warmteterugwinning; warmtekrachtinstallaties; brandstofcellen; warmtepompen; elektromotoren met hoog rendement en/of regelbare toerenregeling; wit schilderen van tanks (alleen meerkosten), et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:30d0d535c7af9786405ab0e486c61a768486b9933b33951c9b6d534c6e6b9493 ;
    skos:prefLabel "Milieu-investeringen tegen luchtverontreiniging"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080020402 a skos:Concept ;
    skos:definition "Milieu-investeringen om waterverontreiniging te voorkomen of te beperken. Voorbeelden: afvalwaterzuiveringen; gescheiden rioleringsstelsels; apparatuur voor lozings- en concentratiemetingen, et cetera."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ecac6b0d7fac5a3f1781d0eaafbc9e720add8d74c009e29fd0d4e05c8bfdf89f ;
    skos:prefLabel "Milieu-investeringen tegen waterverontreiniging"@nl ;
    skos:topConceptOf cbsVar: .

