    skos:prefLabel "Pachtinkomsten horeca"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea20 a skos:Concept ;
    skos:definition "Opbrengst van de verkoop van reproducties, gidsen, kaarten, catalogi en dergelijke die aan de kassa of in een museum verkocht worden."@nl ;
