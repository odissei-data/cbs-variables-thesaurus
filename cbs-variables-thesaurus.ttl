    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea42 a skos:Concept ;
    skos:definition "De vergoeding die een museum ontvangt van de verzekeringsmaatschappij voor ingediende claims (anders dan ziekte). Bijvoorbeeld voor schade."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a1495113e80c23d3c0464ef5b7b9f7a8116932229e4ec8b21b1442ffff189aeb ;
    skos:prefLabel "Overige verzekeringsuitkering"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea59 a skos:Concept ;
    skos:definition "De opbrengsten uit de eigenlijke bedrijfsvoering, inbegrepen zijn onder andere publieksinkomsten, subsidies en bijdragen van de overheid."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d298ed04e125382d96e74c7f3882ffea875d1085e2fcb675948e0985da2ce403 ;
    skos:prefLabel "Opbrengst eigenlijke bedrijfsvoering"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea5a a skos:Concept ;
    skos:definition "Het loon van personeel in dienst van een museum, voor aftrek van de loonheffing, de werknemerspremies voor pensioen en Vervroegde Uittredingregeling (vut), het spaarloon en de premies voor werknemersverzekeringen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e80ad4f4783eb5fffa30d8ae6ee4910da297f6c42d0dff76eedeb07c06c8605b ;
    skos:prefLabel "Arbeidskosten eigen personeel_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea5b a skos:Concept ;
    skos:definition "Afdrachten van pensioenlasten van personeel in dienst van het museum."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:532e7444740b0b0bffaa64936a5d01f2f440b06eba057bab6b7314fbf3823f99 ;
    skos:prefLabel "Pensioenlasten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea5c a skos:Concept ;
    skos:definition "De werkgeversbijdragen in het kader van de sociale zekerheid. Deze omvatten de toegerekende en werkelijke sociale premies en de werkelijke pensioenpremies."@nl ;
