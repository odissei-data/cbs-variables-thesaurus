    skos:definition "Hulpvariabele: Uitkering Toeslagenwet, verwerkt in toedeling onbekend inkomen"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:83914027b1cf626df1a14d8e448d652071b09ea539353109affaff98cd2f4ab1 ;
    skos:prefLabel "Uitkering Toeslagenwet, verwerkt in toedeling onbekend inkomen"@nl ;
