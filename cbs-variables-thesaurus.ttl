    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea96 a skos:Concept ;
    skos:definition "De financiële baten minus de financiële lasten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:8cc86d4b207cbc5e3d1a7d4a3244113468ead422d186c5fb9d4a7138753fafc2 ;
    skos:prefLabel "Financieel resultaat"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea97 a skos:Concept ;
    skos:definition "Het verschil tussen de toevoegingen en onttrekkingen aan reserves en/of voorzieningen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d9c4ef4f600a76166ed09257b29b9151be0afb78f13e649f930befca8c537837 ;
    skos:prefLabel "Saldo reserves en voorzieningen"@nl ;
