    skos:narrower cbsVar:09d2baf656555761964ff3c6dc61a10101331b13506a598cedc3697cd62b01c8 ;
    skos:prefLabel "Rentekosten van milieu-investeringen tegen bodemverontreiniging"@nl ;
    skos:topConceptOf cbsVar: .

