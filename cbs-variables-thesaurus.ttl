    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209e1f a skos:Concept ;
    skos:definition "Hoofdvervoermiddel van een beroepsmatige verplaatsing van een persoon ingedeeld in een klasse. Beroepsmatige verplaatsingen worden gemaakt door bijvoorbeeld pakketbezorgers, taxichauffeurs et cetera"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2bf37eb04eb8089b199c3717cf7f53312fd5fc2e803a30a4c4dc1d72d918d46e ;
