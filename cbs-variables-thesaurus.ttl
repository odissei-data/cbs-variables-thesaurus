    skos:narrower cbsVar:9729ce7ca60b05bf16dce46f03c9a38d6101f711a518a4cc28e3c4e9fbfb5891 ;
    skos:prefLabel "Opbrengsten ter dekking wettelijk budget_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080363809 a skos:Concept ;
    skos:definition "De studiebelasting van een opleiding"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d0bce4363f827ba403ac6888673deb4baf51b8b39fb35b3ccd54d554227ef556 ;
