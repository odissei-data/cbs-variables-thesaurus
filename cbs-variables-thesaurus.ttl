cbsVar:0b01e41080214476 a skos:Concept ;
    skos:definition "Totaal van alle aftrekposten die betrekking hebben op box 1. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b7621572a22dc933ba953a7514fcc9eb1c629ff38895c14fed67871ab3d9dccb ;
    skos:prefLabel "Aftrekposten box 1: Totaal"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214477 a skos:Concept ;
    skos:definition "Fiscale aftrekposten voor werknemers. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a0374af13829f30d0ad4112847c3a52413ef4211cb8ee30dd9411263c6abc752 ;
    skos:prefLabel "Aftrekpost box 1: Aftrek werknemers"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214478 a skos:Concept ;
    skos:definition "Fiscale aftrek wegens geen of geringe eigenwoningschuld. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:dfba14f0203ad6fd2af6cc7138cc95661374c6e658685c7cf96925e4fe6af469 ;
    skos:prefLabel "Aftrekpost box 1: Geen of geringe eigenwoningschuld"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214479 a skos:Concept ;
    skos:definition "Fiscale aftrek van rente en financieringskosten van de eigen woning. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:917eba26bb5867c0c986a8821254fb53cc9a68825aac65c6b7f7da3bb2717f51 ;
    skos:prefLabel "Aftrekpost box 1: Rente van schulden eigen woning"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021447a a skos:Concept ;
    skos:definition "De investeringsaftrek is een bedrag dat een ondernemer in mindering kan brengen op de winst wanneer hij in bedrijfsmiddelen heeft geïnvesteerd. De desinvesteringsbijtelling is een verhoging op de winst. De desinvesteringsbijtelling vindt plaats indien een bedrijfsmiddel wordt vervreemd binnen vijf jaar na het begin van het kalenderjaar waarin de investering heeft plaatsgevonden op het bedrijfsmiddel waarop investeringsaftrek is genoten. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:06f559eca46b2ebe1a5338e77d7b815d9e55386985e96d2a34120afbf1785fb6 ;
    skos:prefLabel "Aftrekpost box1: Investeringsaftrek"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021447b a skos:Concept ;
    skos:definition "Fiscale aftrek van uitgaven voor kinderopvang. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cda4063a1f388ab029ac69d0f949fb36ec3bb2328f8523dd41f220d255ac9d02 ;
    skos:prefLabel "Aftrekpost box 1: Kinderopvang"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214490 a skos:Concept ;
    skos:definition "Totale fiscale aftrek van uitgaven voor inkomensvoorzieningen. Negatieve uitgaven (ontvangen afkoopsommen of terugontvangen premies) zijn hiervan afgetrokken. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ad9147eb96c2fc34378333fbb75a79f58c9549e6dddf14c6cca5ae6a07e0340e ;
    skos:prefLabel "Aftrekpost box 1: Inkomensvoorzieningen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214491 a skos:Concept ;
    skos:definition "Het totaal van zelfstandigenaftrek (inclusief startersaftrek), aftrek speur- en ontwikkelingswerk, meewerkaftrek, stakingsaftrek, en vanaf 2007 startersaftrek bij arbeidsongeschiktheid. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cce1f66f447436c23878eb0d2a041c841b543704f8cce7c09688f7a713583294 ;
    skos:prefLabel "Aftrekpost box 1: Ondernemersaftrek"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214492 a skos:Concept ;
    skos:definition "Het totaal van rente en financieringskosten van de eigen woning, periodieke betalingen voor erfpacht, opstal of beklemming, en aftrek wegens geen of geringe eigenwoningschuld. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a01abcc6d5a79c7b074ee1ef30a1eea349b9d61d7aabc9edabf5cbf18c88f984 ;
    skos:prefLabel "Aftrekpost box 1: Eigen woning"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214496 a skos:Concept ;
    skos:definition "Algemene korting die men krijgt op de gemeentelijke heffing of belasting."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7254b86e441aad9369fe4334ae72ed9916c8e953429fa78210b64f88782e4329 ;
    skos:prefLabel "Heffingskorting (gemeentelijke heffing)"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214497 a skos:Concept ;
    skos:definition "Fiscale aftrek vanwege giften aan goede doelen. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:fc6949d186b4b5c21d35d8a3da774bbdd4e1c72d33d6bce9f20a56c41ac0b579 ;
    skos:prefLabel "Persoonsgebonden aftrekpost: Giften"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214498 a skos:Concept ;
    skos:definition "Fiscale aftrek wegens kwijtschelding van een lening aan een startende ondernemer. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:61c661bcc2b6049b210d98bc8050bbd2bfecc1350887444474b743341f9b8de8 ;
    skos:prefLabel "Persoonsgebonden aftrekpost: Kwijtgescholden durfkapitaal"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214499 a skos:Concept ;
    skos:definition "Fiscale aftrek kosten voor een rijksmonumentenpand. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1fa7fa936c47bf5b8972a819a077503eb25e9c20191a87016f3687698891d457 ;
    skos:prefLabel "Persoonsgebonden aftrekpost: Onderhoudskosten monumentenpand"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802144ae a skos:Concept ;
    skos:definition "Fiscale aftrek van kosten voor levensonderhoud van kinderen. De aftrek bestaat uit een forfaitair bedrag per kwartaal waarin aan de voorwaarden wordt voldaan. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:db5c0fb7908c4cb8f57157713a146a4f7f309233e1a975b97065a390fc5ae6b6 ;
    skos:prefLabel "Persoonsgebonden aftrekpost: Levensonderhoud kinderen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802144af a skos:Concept ;
    skos:definition "Totale fiscale aftrek van de minst voorkomende persoonsgebonden aftrekposten: uitgaven voor tijdelijk verblijf thuis van ernstig gehandicapten, onderhoudskosten monumentenpand, kwijtgescholden durfkapitaal en het restant persoonsgebonden aftrek over vorige jaren. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:61a0ec37faa344734c36eed5883189fe330cb561f09763eb14fd40514cb4d096 ;
    skos:prefLabel "Persoonsgebonden aftrekpost: Overig (totaal)"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802144b0 a skos:Concept ;
    skos:definition "Deel van de persoonsgebonden aftrek dat niet verzilverd kan worden, en doorschuift naar een volgend jaar. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:183dcb5a8afdb688488d4c062e7d78954ac0756c17c4290cec199ad3b383b613 ;
    skos:prefLabel "Aangifte: Niet-verzilverbare deel van de persoonsgebonden aftrek"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802144b1 a skos:Concept ;
    skos:definition "Marginaal verzilverde deel van de totale persoonsgebonden aftrek exclusief de betaalde alimentatie. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:6a83207c0007a62663f9c1b9b7d67ac76fe436310f9dc07a6d31e1bbaba088da ;
    skos:prefLabel "Persoonsgebonden aftrek: Marginaal verzilverd exclusief alimentatie"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802144b2 a skos:Concept ;
    skos:definition "Restant persoonsgebonden aftrek over vorige jaren dat niet eerder kon worden verrekend met inkomen over die jaren in box 1, 3 of 2. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:61a028c8adbd8642389314fd407e4a31b2d36638cc86d55a417837d9602bb2d8 ;
