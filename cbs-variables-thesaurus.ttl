    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802f373e a skos:Concept ;
    skos:definition "Zou een persoon meer hulp willen hebben bij een of meer instrumentele Algemene Dagelijkse Levensverrichtingen (ADL)-activiteiten?"@nl ;
