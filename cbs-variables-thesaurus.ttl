        cbsVar:8e1585a367d975e30129367b6d54396a903f5e234999f7dca9f1dfa0ce04e516 ;
    skos:prefLabel "Gemiddeld aantal specifiek ingeleend personeel"@nl ;
    skos:topConceptOf cbsVar: .

