    skos:definition "De inkoopprijs van dranken, snacks en dergelijke."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ce272e2e663617f40e5f0f526fa3246687a520e6d6e7c6921af812fcb91fc243 ;
    skos:prefLabel "Inkoopkosten horeca"@nl ;
