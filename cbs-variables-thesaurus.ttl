    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108025c816 a skos:Concept ;
    skos:definition "Het bedrag dat een huishouden heeft betaald aan alimentatie."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d8de093ea3ebdf8a94191644963c48b55636d30e9318f41e65f7bedf8e5e2d96 ;
