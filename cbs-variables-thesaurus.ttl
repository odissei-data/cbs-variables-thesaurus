    skos:prefLabel "Cluster zorgactoren"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803d4909 a skos:Concept ;
    skos:definition "Het rangnummer van een bestandsregel om het bestand te kunnen sorteren op actornamen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:27c6a50bb8b6088c296a0bc17a52cca6c33cf744813478a62f100793b172bf2b ;
