    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209e3a a skos:Concept ;
    skos:definition "Deze variabele geeft aan of de ritten gebaseerd zijn op uitvraag in de vragenlijst (bij verplaatsingen met minstens één Openbaar Vervoer rit ), op rittenimputatie ( bij verplaatsingen met één of meer ritten zonder Openbaar Vervoer en bij beroepsmatige verplaatsingen) of op een andere imputatie (correctie verplaatsingen naar ritten of laatste naar-huis verplaatsingen)."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:f46442ff15966ae31a5906750680f6d3f711479f3be2a9315bd28c65d1ba5d1b ;
    skos:prefLabel "Indicator van bron van ritinformatie"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209e3b a skos:Concept ;
    skos:definition "Een chronologisch oplopende nummering van de ritten in een verplaatsing van een onderzoekspersoon: 1, 2,…"@nl ;
