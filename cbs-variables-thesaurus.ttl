    skos:narrower cbsVar:89c8017fab6471a60e4b1993e4808a98ef8849222a69fdfe7700b215821f794a ;
    skos:prefLabel "Inkomen uit buitenlandse beleggingen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802143ff a skos:Concept ;
    skos:definition "Hulpvariabele: Fiscaal bedrag Pensioen/lijfrente (inclusief toedeling onbekend inkomen)"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:813a8d37c93a6450dd1c20f22d334cd2930a357e24d25b0b8b9ca3fe52a23f3d ;
    skos:prefLabel "Uitkering inkomensverzekeringen: Fiscaal bedrag Pensioen en lijfrente"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214400 a skos:Concept ;
    skos:definition "Uitkering inkomensverzekeringen: Overige uitkeringen en verstrekkingen (anders dan overheidsbijdragen voor de eigen woning en anders dan uitkering in verband met invaliditeit, ziekte of ongeval, en anders dan alimentatie), waaronder lijfrentetermijnen waarop geen loonheffing is ingehouden. Verstrekkingen zijn uitkeringen in een andere vorm dan geld, dus uitkeringen in natura."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7dc61a028072ddb02bf77ed7ec7d0b41c10bcd0fe65c5646aafea45d1b460dde ;
    skos:prefLabel "Overige uitkeringen en verstrekkingen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214401 a skos:Concept ;
    skos:definition "Uitkering inkomensverzekeringen: Uitkeringen in verband met invaliditeit, ziekte of ongeval uit particuliere verzekering waarop geen loonheffing is ingehouden"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:827b9d068c7a17c3a473d2e385338cb4cfc14a7a9f78826e125d4eb6b5a47e6c ;
    skos:prefLabel "Uitkeringen in verband met invaliditeit, ziekte of ongeval"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214402 a skos:Concept ;
    skos:definition "Som van onbekend fiscaal loon uit de loonaangifte en additioneel waargenomen fiscaal loon uit de aangifte inkomstenbelasting dat wordt toebedeeld aan de belangrijkste inkomenssoort in de loonaangifte."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e39a19409dbc33bed2e80d377555d5d35efb829c88f4889661110f49a987f631 ;
    skos:prefLabel "Hulpvariabele: Onbekend inkomen uit loonaangifte en overschot uit aangifte inkomstenbelasting"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214403 a skos:Concept ;
    skos:definition "Som van onbekend fiscaal loon uit de loonaangifte en additioneel waargenomen fiscaal loon uit de aangifte inkomstenbelasting dat wordt toebedeeld aan de belangrijkste inkomenssoort in de loonaangifte. Bedrag voor correctie van extreme bedragen uit de aangifte inkomstenbelasting."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:c42253a1a34867c3f37fd6482d642997be430f5fe6f3e53b6196a9cc512b2f82 ;
    skos:prefLabel "Hulpvariabele: Onbekend inkomen uit loonaangifte en overschot uit aangifte inkomstenbelasting (voor afkapping)"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214418 a skos:Concept ;
    skos:definition "Rente-inkomsten van minderjarige kinderen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:49d3e8e3365ea0e770558e268aae87585b23b8357d692d9247f4e10b11a52bba ;
    skos:prefLabel "Rente-inkomsten van minderjarige kinderen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214419 a skos:Concept ;
    skos:definition "Rente uit saldi niet vrijgesteld voor inkomstenbelasting. Dus rente-inkomsten exclusief rente over durfkapitaal en maatschappelijke beleggingen, werknemersspaarrekening en minderjarige kinderen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0ac179f85e8d07aab31e235425197025ddcb27357fe664c72bea122e74a4df96 ;
    skos:prefLabel "Rente-inkomsten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021441a a skos:Concept ;
    skos:definition "Rente-inkomsten uit werknemersspaarregeling. Deze regeling is een Nederlandse fiscale faciliteit voor werknemers om voordelig te sparen. Vanaf 1-1-2012 is de werknemersspaarregeling afgeschaft. Er kan niet meer ingelegd worden, de tegoeden worden afgebouwd en eind 2015 komen alle resterende tegoeden vrij. De werknemersspaarregeling is vanaf 2011 dan ook niet meer opgenomen in de rente/dividendbase. Hierdoor moeten de inkomsten in latere jaren worden geimputeerd op grond van de laatste waarneming."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b2dc526b0758e0a55b14c14564832b07566242599f0d36d60a26815e0c7c416f ;
    skos:prefLabel "Rente-inkomsten werknemersspaarrekeningen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021441b a skos:Concept ;
    skos:definition "Belast deel uit kapitaalverzekering eigen woning en overige vermogensinkomsten met betrekking tot de periode voor 1 januari 2001."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a90cbb68ae88087224214fe7a9865589c9160f4ddf07adf0d85187e1b90e6516 ;
    skos:prefLabel "Rente kapitaalsuitkering en overige"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021441c a skos:Concept ;
    skos:definition "Rente-inkomsten van durfkapitaal en maatschappelijke beleggingen. De regeling durfkapitaal staat ook wel bekend als de Tante Agaath-regeling. Dit is een regeling ter bevordering van het verstrekken van leningen aan startende ondernemers. Onder deze regeling vallen ook culturele beleggingen. Maatschappelijke beleggingen (groene beleggingenen sociaalethische-beleggingen) zijn beleggingen in fondsen die deelnemen in projecten voor milieubescherming of ontwikkelingssamenwerking."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:c98015221b5aa7dd8063a1743f4b31d0ae83173635e16381fc49672e3a024470 ;
    skos:prefLabel "Rente-inkomsten van durfkapitaal en maatschappelijke beleggingen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021441d a skos:Concept ;
    skos:definition "Inkomen uit arbeid: Spaarloon"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:308a236205dbb274309a5ddb0dd7be8d13c9a171011e240f9531cec3436933b5 ;
    skos:prefLabel "Spaarloon"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021441e a skos:Concept ;
    skos:definition "Het totaal aan basisbeurs en aanvullende beurs dat in het betreffende kalenderjaar ontvangen is in het kader van de WSF (Wet studiefinanciering)."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1d7d8bf99da7dca2a8aef4a6c782d3c8f1226a83eb648ffad0699d9af3d0992b ;
    skos:prefLabel "Bedrag Studietoelage (beurs) WSF"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021441f a skos:Concept ;
    skos:definition "Het maximale recht op lening dat in het betreffende kalenderjaar ontvangen kan worden in het kader van de WSF (Wet studiefinanciering). Hierin is ook het collegegeldkrediet opgenomen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:40dbc8ce41483b7137727885f7c7a0f15386bd85d349772caed3794842b828f2 ;
    skos:prefLabel "Recht op lening (WSF)"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214420 a skos:Concept ;
    skos:definition "Aangifte: Terugontvangen bedrag of vergoeding voor een bedrag dat eerder is afgetrokken in de persoonsgebonden aftrek"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:edf5e3d307a2599469e61e83c0e103b969c4af085829f177748f8310a12e584b ;
    skos:prefLabel "Aangifte: Terugontvangen bedrag of vergoeding voor een bedrag dat eerder is afgetrokken"@nl ;
    skos:topConceptOf cbsVar: .

