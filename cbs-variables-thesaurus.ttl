    skos:narrower cbsVar:2bc0329e03754009a8f65941629194ea9187a5638e1f8bb2a8cb44922ac3ff9e ;
    skos:prefLabel "Vrijstelling box 1: MKB-winstvrijstelling en terbeschikkingstellingsvrijstelling"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802145fd a skos:Concept ;
    skos:definition "Fiscale vrijstelling in box 1 van de inleg van het spaarloon. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:20e883e68996e5f9af6bdd17489633c1ff527d3660aacd995bd7c771ac675316 ;
    skos:prefLabel "Vrijstelling box 1: Inleg spaarloon"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802145fe a skos:Concept ;
    skos:definition "Fiscale vrijstelling in box 1 van uitkering uit een kapitaalverzekering eigen woning of andere kapitaalverzekering. Totaal van alle huishoudensleden."@nl ;
