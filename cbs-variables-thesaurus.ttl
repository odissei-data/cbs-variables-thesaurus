    skos:narrower cbsVar:15f2bcd9e37b7e49ae3f388e6b895239c6486e4ecb698ea72540ddf6c3cf3797 ;
    skos:prefLabel "Feitelijk aantal gewerkte uren_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410803b1643 a skos:Concept ;
    skos:definition "Dit betreft een speciale afgeleide variabele uit een Engelstalig onderzoek voor Eurostat. Deze variabele beschrijft kenmerken van de door de respondent als tweede genoemde informele leeractiviteit."@nl ;
