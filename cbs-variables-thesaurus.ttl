    skos:narrower cbsVar:b36cb507e9d8eea61c442c19a31fbde892dab885c5f12adcb7174644c013892e ;
    skos:prefLabel "Verplaatsingsnummer"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209da1 a skos:Concept ;
