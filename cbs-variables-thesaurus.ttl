cbsVar:0b01e410802c8562 a skos:Concept ;
    skos:definition "De geconsolideerde productie is de productie die overblijft als de eenheid (bedrijfsklasse, bedrijfstak of de commerciële sector) wordt beschreven als één enkel bedrijf."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:76b3a93a1d336c0be90c553030d709c56892f70ba3f6f4085cfce22042ad8dbc ;
