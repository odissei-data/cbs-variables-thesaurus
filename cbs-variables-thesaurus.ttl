cbsVar:0b01e41080209e37 a skos:Concept ;
    skos:definition "Indicator die aangeeft of verplaatsingen zijn omgecodeerd tot ritten van een overkoepelende verplaatsing."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:f993de4964439935e51d04a959840d70a0ffea12d61f13048a6eefabaf42417a ;
    skos:prefLabel "Indicator van correctie verplaatsingen naar ritten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209e38 a skos:Concept ;
    skos:definition "Indicator die aangeeft of een terug naar-huis verplaatsing op het eind van de invuldag is geïmputeerd. Ook geeft deze indicator aan of de door de onderzoekspersoon opgegeven laatste verplaatsing is gewijzigd qua afstand."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0457bd4781bac5f0641ec5baa91d765d84cb7b28d9c4dd1c196364744d1e634c ;
