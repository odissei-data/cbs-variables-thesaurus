    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108025c7fb a skos:Concept ;
    skos:definition "Bedrag dat een huishouden heeft ontvangen aan alimentatie."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:679a2f2a8798f1816ee3eb8d2a5ecac5704708a683f6d92b2d77c2202907f5f1 ;
    skos:prefLabel "Bedrag ontvangen alimentatie"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108025c7fc a skos:Concept ;
    skos:definition "Het bedrag van rente van activa zoals bankrekeningen, depositocertificaten, obligaties, enzovoort, dividenden en winsten uit kapitaalinvesteringen in een bedrijf zonder rechtspersoonlijkheid"@nl ;
