    skos:narrower cbsVar:ed3b6bbf5f2b981215d0d39b79ef819a3826b6f37728343d3dae18a6d741c3a8 ;
    skos:prefLabel "Te verrekenen voorheffing van dividendbelasting en kansspelbelasting"@nl ;
