    skos:prefLabel "Vertrekpunt verplaatsing is aankomstpunt?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209da2 a skos:Concept ;
    skos:definition "Het aantal ritten (vervoermiddelen) in een verplaatsing van een persoon."@nl ;
