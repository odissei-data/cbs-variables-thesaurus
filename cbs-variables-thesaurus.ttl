    skos:narrower cbsVar:3ec02fab23799fba6315b55b3ddbf2843135ab516222cf0656b2941183c809d2 ;
    skos:prefLabel "Sociale lasten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea5d a skos:Concept ;
    skos:definition "De kosten van ingeleend personeel van derden."@nl ;
