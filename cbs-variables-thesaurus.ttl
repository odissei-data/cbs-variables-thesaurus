cbsVar:0b01e410800203c5 a skos:Concept ;
    skos:definition "Netto milieulasten ter voorkoming of beperking van het ontstaan van afvalstoffen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:f02a1d096702b092826a6286c0b73fee274ae577fb5216e1fc4c5e9dba1a2afb ;
    skos:prefLabel "Netto milieulasten afval"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203c6 a skos:Concept ;
    skos:definition "Netto milieulasten van compartiment 'algemeen'. Hieronder zijn opgenomen de netto milieulasten die betrekking hebben op meer dan een compartiment of die niet aan een compartiment kunnen worden toegerekend. Hiertoe zijn gerekend kosten voor milieuonderzoek, milieucoördinatie, leges voor milieuvergunningen en schadebetalingen en milieuboeten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:6f250a9bfdceda22cdbc0070df07f61f1d497a63b672180092e529ca464a9eb9 ;
    skos:prefLabel "Netto milieulasten algemeen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203c8 a skos:Concept ;
    skos:definition "Netto milieulasten om geluidshinder te voorkomen of te beperken."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:3ee7cd1ad8344e56d232f3f2919233f932fa1dfad36d49d953b80985099c1890 ;
    skos:prefLabel "Netto milieulasten geluidshinder"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410800203e1 a skos:Concept ;
    skos:definition "Rentekosten van de milieu-investeringen ter voorkoming of beperking van aantasting van natuur en landschap."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:00fe3ef53ee01fc83a43ecd7f2b1076b599c26f2b8245b6cdf31b28f0ebab0ff ;
    skos:prefLabel "Rentekosten van de milieu-investeringen tegen aantasting van natuur en landschap"@nl ;
    skos:topConceptOf cbsVar: .

