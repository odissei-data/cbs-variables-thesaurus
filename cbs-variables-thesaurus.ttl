    skos:narrower cbsVar:8b28ca6ca6e6cf13c457368d08d4b58ccb6aea493ea1c3cd334278426a524cd0 ;
    skos:prefLabel "Totaal vrijstellingen box 1"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802145fc a skos:Concept ;
    skos:definition "Fiscale vrijstelling in box 1 van een percentage van de winst na ondernemersaftrek of van de netto opbrengsten uit ter beschikking gestelde vermogensbestanddelen. Totaal van alle huishoudensleden."@nl ;
