    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802c8565 a skos:Concept ;
    skos:definition "De energieproducten omvatten naast de producten geproduceerd door de energie- en waterleidingbedrijven ook energiedragers als steenkool en (ruwe en verwerkte) olie en gas. Het geconsolideerde verbruik van energie is het verbruik van energie dat overblijft als de eenheid (bedrijfsklasse, bedrijfstak of de commerciële sector) wordt beschreven als één enkel bedrijf."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d9f9ee2266f2a2377a0aa41710bb2012c5e90d27292ee5e9a0860d8046070e94 ;
    skos:prefLabel "Waarde van het geconsolideerd intermediair verbruik van energie"@nl ;
    skos:topConceptOf cbsVar: .

