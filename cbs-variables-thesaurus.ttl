    skos:narrower cbsVar:75ae871c03560bbb27096b956c807f9f3aab94c869a29c940b4acfd53e163513 ;
    skos:prefLabel "Slibleeftijd"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ac57 a skos:Concept ;
    skos:definition "De hoeveelheid geproduceerd zuiveringsslib in de biologische trap (beluchtingsruimte of oxidatiebed), per verwijderde hoeveelheid Chemisch Zuurstof Verbruik (CZV), uitgedrukt in gram droge stof per verwijderde kilogram CZV."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:47fd60e1acd6beaa4be946bb82df40fa0b2dc50f93b1ce40ee152b746aaaee01 ;
    skos:prefLabel "Specifieke slibproductie per verwijderde hoeveelheid Chemisch Zuurstof Verbruik"@nl ;
    skos:topConceptOf cbsVar: .

