    skos:narrower cbsVar:2209d2f455aa673c5db537b293f4d38868d702e80eeb79526165fdf4a00561ba ;
    skos:prefLabel "Terugontvangen bedrag premie voor lijfrenten of arbeidsongeschiktheidsverzekering"@nl ;
