    skos:prefLabel "Huurkosten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108020ea61 a skos:Concept ;
    skos:definition "De kosten van regulier (klein) onderhoud van de gebouwen en/of terreinen."@nl ;
