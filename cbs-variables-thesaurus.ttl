    skos:narrower cbsVar:1e3c537d6fc7950c7f6c035b6659b728c882f4e1ec368d9c718069b50af5e6a1 ;
    skos:prefLabel "Schulden uit hoofde van bekostiging_n02"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108036117e a skos:Concept ;
    skos:definition "Opbrengsten ter dekking van het wettelijk budget aanvaardbare kosten voor zorg in natura van door de Wet langdurige zorg gefinancierde zorg."@nl ;
