    skos:narrower cbsVar:04d225dc8400aeb3162dd01f33ac735d587ba551fc570fcc0274843ac95ac94a ;
    skos:prefLabel "Vrijstelling box 1: Uitkering uit kapitaalverzekering"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802145ff a skos:Concept ;
    skos:definition "Fiscale vrijstelling in box 1 van winstbestanddelen (objectieve vrijstellingen): bosbouw- en landbouwvrijstelling, vrijstelling voor kwijtscheldingswinst, stakingsvrijstelling, mobiliteitsprojectvrijstelling (vanaf 2010), en overige vrijgestelde winstbestanddelen. Hieronder valt niet de MKB (Midden- en kleinbedrijf)-winstvrijstelling. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:06fd3c004ae44e48eb7a146e81f816e12748ca7fbc21e7750d70758cab0c9165 ;
    skos:prefLabel "Vrijstelling box 1: Winstbestanddelen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214600 a skos:Concept ;
    skos:definition "Totaal fictief rendement uit fiscaal vrijgesteld vermogen in box 3. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:36fa4bcb679b6057850e4ac280599cf0e284b8aa185caa063935260f9a9a2226 ;
    skos:prefLabel "Totaal fictief rendement uit vrijgesteld vermogen in box 3"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214601 a skos:Concept ;
    skos:definition "Fictief rendement uit fiscaal vrijgestelde beleggingen. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:6f7698259e112ca55900de4e57e511d289ca9c0b86729f5330f0bb3553cf16f7 ;
    skos:prefLabel "Vrijstelling box 3: Fictief rendement uit beleggingen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214616 a skos:Concept ;
    skos:definition "Fictief rendement uit fiscaal vrijgestelde tegoeden of beleggingen in het kader van de wet bedrijfsspaarregelingen. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9688b081c6bbbdd5968248d2df5cae6db21a73f88d75f884faea3f5f2ce1f6c3 ;
    skos:prefLabel "Vrijstelling box 3: Fictief rendement uit vrijgesteld spaarloontegoed"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214617 a skos:Concept ;
    skos:definition "Fictief rendement uit het vermogen dat vanwege de drempel van heffingsvrij vermogen, de toeslag heffingsvrij vermogen minderjarige kinderen, en de ouderentoeslag niet wordt belast. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:190a7e1ea96d6c104ab582287865aeb80378ee4d9448427b54342200822c54f5 ;
    skos:prefLabel "Vrijstelling box 3: Fictief rendement uit heffingsvrij vermogen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214618 a skos:Concept ;
    skos:definition "Versienummer (volgnummer) belastingdrukgegevens."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:8e1536c0e1f48a58a3378c1d5187340527bd31b8fea91e4609c8fc1a8f4c6237 ;
    skos:prefLabel "Versienummer belastingdrukgegevens"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214619 a skos:Concept ;
    skos:definition "Totaal van alle fiscale vrijstellingen die betrekking hebben op box 1 en van het fictief rendement uit vrijgesteld vermogen in box 3. Totaal van alle huishoudensleden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:4e7a060a403b131ac5234630d412fc74b8802645cf6fd914ad2bf387643df483 ;
    skos:prefLabel "Totaal vrijgesteld inkomen of fictief rendement in box 1 of 3"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021461c a skos:Concept ;
    skos:definition "Peildatum vermogen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9b5f10bef7895036fbb2f11ce93b3b95c385020eae728ef68b7af1e13f937931 ;
    skos:prefLabel "Peildatum vermogen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021461d a skos:Concept ;
    skos:definition "Versienummer (volgnummer) vermogensgegevens."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:67112221bbc8abc1a4827c60ea247996df2b3ee5ca8799d50c3fc6f31897ce7f ;
    skos:prefLabel "Versienummer vermogensgegevens"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214634 a skos:Concept ;
    skos:definition "Totaal aan financiële bezittingen van het huishouden. Financiële bezittingen worden gevormd door bank- en spaartegoeden, obligaties en aandelen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:505b074b34d6138902206cc090d2fa01169508a2c6f08cde49a24ad56eb448e3 ;
    skos:prefLabel "Totaal aan financiële bezittingen van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214635 a skos:Concept ;
    skos:definition "Totaal aan bank- en spaartegoeden van het huishouden. Alle tegoeden op rekeningen bij (spaar)banken, inclusief buitenlandse tegoeden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2c1fdd2b4e9fea83dbd3badad761ea7439a5affaef11e7f085fc05862c185c27 ;
    skos:prefLabel "Totaal aan bank- en spaartegoed van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214636 a skos:Concept ;
    skos:definition "Totaal aan belastbare spaartegoeden van het huishouden. Alle tegoeden op rekeningen bij (spaar)banken, inclusief buitenlandse tegoeden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:513398b6bf5cc6abcd372653ced5fd3517cf91fbbb9a97ebde3b68fefef529bc ;
    skos:prefLabel "Spaartegoed belastbaar van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214637 a skos:Concept ;
    skos:definition "Totaal aan spaartegoed spaarloon van het huishouden. Spaarloon is een Nederlandse fiscale faciliteit voor werknemers om voordelig te sparen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:95e4e9252494b5bf56e8619be34fa0f145f3593d1e594496de2a40671e58eebf ;
    skos:prefLabel "Spaartegoed spaarloon van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214638 a skos:Concept ;
    skos:definition "Waarde van obligaties van het huishouden. Het gaat hierbij specifiek om de beurswaarde van waardepapieren in de vorm van een schuldbekentenis tegen een vaste rente."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b1a00e377006614bd29249934767a73e5adff4f35d07057d1127aedf9e58108f ;
    skos:prefLabel "Obligaties van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021463a a skos:Concept ;
    skos:definition "Waarde van belastbare aandelen in box 3 van het huishouden, exclusief aandelen aanmerkelijk belang."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:054aebad75b31a580016bc73f288ac1022e8e9f001ae396fbf318618a352ac74 ;
    skos:prefLabel "Aandelen belastbaar van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021463b a skos:Concept ;
    skos:definition "Waarde van aandelen spaarloon van het huishouden. Spaarloon is een Nederlandse fiscale faciliteit voor werknemers om voordelig te sparen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9a6ee59ca7b52e4d42723301978199aa569a4d50ab3004f961430a12f515d1ee ;
    skos:prefLabel "Aandelen spaarloon van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021463c a skos:Concept ;
    skos:definition "Waarde van vrijgestelde aandelen van het huishouden. Het gaat om beleggingen in durfkapitaal en maatschappelijke beleggingen. De regeling durfkapitaal staat ook wel bekend als de Tante Agaath-regeling. Dit is een regeling ter bevordering van het verstrekken van leningen aan startende ondernemers. Onder deze regeling vallen ook culturele beleggingen. Maatschappelijke beleggingen (groene beleggingenen sociaalethische beleggingen) zijn beleggingen in fondsen die deelnemen in projecten voor milieubescherming of ontwikkelingssamenwerking."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e4b1475fd587b4e30126b6f3dbf07552bebe67f91515e70ca06b47acef7ad341 ;
    skos:prefLabel "Aandelen vrijgesteld van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021463d a skos:Concept ;
    skos:definition "De beurswaarde van aandelen van het huishouden, exclusief aandelen aanmerkelijk belang. De overige aandelen bestaan uit de belastbare aandelen in box 3, de vrijgestelde maatschappelijke beleggingen, en beleggingen van de spaarloonregeling."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:527be5b7d5898238015d36f7453c4365aa8a6209220997a2a6b8f18ac176b84a ;
    skos:prefLabel "Totaal aan overige aandelen van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214652 a skos:Concept ;
    skos:definition "Totale waarde van aandelen van het huishouden. Het totaal aan aandelen van het huishouden is gelijk aan de som van de aandelen aanmerkelijk belang en overige aandelen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:ed5c134a3286ede0501f699bd137f31f7be61f58540cf3e17833513c85311a1a ;
    skos:prefLabel "Totaal aan aandelen van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214653 a skos:Concept ;
    skos:definition "Totaal aan onroerend goed van het huishouden. Het totaal aan onroerend goed is gelijk aan de som van de waarde van de eigen woning en de waarde van het overig onroerend goed."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:519075c89047fdc2c2b0b96c9d7b194dddf2e38dfcb03a13c02cee2ea38fdf11 ;
    skos:prefLabel "Totaal aan onroerend goed van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214654 a skos:Concept ;
    skos:definition "Waarde van de eigen woning van het huishouden. De eigen woning is de woning in eigendom en in gebruik als hoofdverblijf."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7a1abcc34080029eec5cefa2c0c770fe06d2296b2935231848fb230f67cad934 ;
    skos:prefLabel "Eigen woning van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214655 a skos:Concept ;
    skos:definition "Totale waarde van onroerend goed van het huishouden, exclusief de eerste woning. Het gaat bijvoorbeeld om een tweede woning, een vakantiehuis, beleggingspanden en dergelijke."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:87bfe02dadb566ba8a6cc01f7a9730ebd1dbe59b84d3d1f6e637e01d785bf6fd ;
    skos:prefLabel "Totaal overig onroerend goed van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214656 a skos:Concept ;
    skos:definition "Waarde van onroerende goed van het huishouden, exclusief eerste en tweede woning. Het gaat bijvoorbeeld om beleggingspanden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1fc471059f0a9f42d06431d9aa58d64fa43c69da3dca022fed34af5c2eff2fc3 ;
    skos:prefLabel "Overig onroerend goed van het huishouden, exclusief woningen"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214657 a skos:Concept ;
    skos:definition "Waarde van de tweede woning van het huishouden, bijvoorbeeld een vakantiehuis."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d59a8ca229500700b9f3a20d637ffe2edbf562f9ad59dfd4a80e3561864a5736 ;
    skos:prefLabel "Tweede woning van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214658 a skos:Concept ;
    skos:definition "Waarde van roerende zaken van het huishouden. Het gaat om bezittingen in de vorm van contant geld, roerende zaken verhuurd of in gebruik als belegging, trustvermogen en dergelijke, aandeel in onverdeelde boedel, vermogen belast met vruchtgebruik of beperkt eigendom (onder andere blote eigendom). Roerende zaken voor eigen gebruik of voor gebruik binnen het gezin, bijvoorbeeld eigen auto of inboedel woning vallen hier niet onder."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:386f8a6b22d032f56142fcb4440b526774b9e5b48d1d38215e10999c1e2475e4 ;
    skos:prefLabel "Roerende zaken van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214671 a skos:Concept ;
    skos:definition "Waarde van effecten van het huishouden. Effecten is gelijk aan de som van aandelen en obligaties."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:410c345ca9b1eea2a904e0a2cf45f24120f6b6f5d9d9c10643d4804b8d69967a ;
    skos:prefLabel "Effecten van het huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080214672 a skos:Concept ;
    skos:definition "Waarde van het totale vermogen van het huishouden, exclusief eigen woning en de daarop rustende hypotheekschuld."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0d172fcaa40a0cb90ea784c10ad28eb259e2f6f7cea8240b3ee46dce48bcfafc ;
    skos:prefLabel "Vermogen van het huishouden, exclusief eigen woning"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802151d0 a skos:Concept ;
    skos:definition "Netto uitgaven voor geproduceerde materiële of immateriële activa die langer dan een jaar in het productieproces worden gebruikt, exclusief afschrijvingen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:f2d07c37f4c067a0ae9cff4ffeb4d8054216d94114b616a46e20dc8430b96e41 ;
    skos:prefLabel "Aanschafwaarde netto investeringen in vaste activa"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215695 a skos:Concept ;
    skos:definition "Aantal feiten in kantonstrafzaken ingeschreven bij het Openbaar Ministerie."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7d35294f7626d15f9fefc7eb01b7ee1704c9c4760ffd4d7cbcd5df0d8dbb1fa6 ;
    skos:prefLabel "Aantal ingeschreven feiten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802156c6 a skos:Concept ;
    skos:definition "Wijze waarop het Openbaar Ministerie (OM) een feit binnen een strafzaak heeft afgedaan."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2a031eec06cd4cab48ad2c190ac59c1dc25e1523a2d46ea7cee8ca7d4ed07667 ;
    skos:prefLabel "Wijze van afdoening door het OM"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802156c9 a skos:Concept ;
    skos:definition "Door het Openbaar Ministerie afgedane feiten in strafzaken"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cf1570d8ada06e33c990afbbfd55c847b340f7ded150713e82653c9a4f577138 ;
    skos:prefLabel "Is het feit door het OM afgedaan?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021572b a skos:Concept ;
    skos:definition "De periode waarin een zitting is vrijgegeven."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cee3a66a38707f11e093a43e7035585e32bd0d1e64b84270e475373097eaf855 ;
    skos:prefLabel "Periode zitting vrijgegeven"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021572c a skos:Concept ;
    skos:definition "Periode waarin de beslissing van de rechterlijke macht is geaccordeerd."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:bd1917d71564c76f871d593ede5580509097de62ef3271f1f07bf371b8d1df8f ;
    skos:prefLabel "Periode waarin rechterlijke macht accoord"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021572d a skos:Concept ;
    skos:definition "Periode waarin de rechter in eerste aanleg een beslissing heeft genomen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:00bbaa5cb33cabb2ce3c1f2c4645deb19dfab07d32b9dbf314a96dd7b5ab1bb6 ;
    skos:prefLabel "Periode beslissing"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021572e a skos:Concept ;
    skos:definition "De aard van de beslissing die de rechter in eerste aanleg op een feit binnen een strafzaak heeft genomen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d5c664338ed1c912422644bd0d8c78c7adc3f587148b729e9fbc3ec9af161485 ;
    skos:prefLabel "Beslissing op een feit binnen een strafzaak"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108021572f a skos:Concept ;
    skos:definition "Feit in een strafzaak waarop de rechter een beslissing heeft genomen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d5012f375e6b7b241bbb484650d31334211cebe3c9b5baca1b34ace6feeed0b7 ;
    skos:prefLabel "Aantal feitenafgedaan door de rechter in eerste aanleg"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215730 a skos:Concept ;
    skos:definition "Aantal straffen dat door een rechter in eerste aanleg is opgelegd bij de beslissingen op de feiten"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a61c443e6789fdd7f83154a9fa2d31ec97036220a76b213321abe4f92731dfc3 ;
    skos:prefLabel "Aantal straffen dat door rechter in eerste aanleg is opgelegd bij de beslissingen op de feiten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215731 a skos:Concept ;
    skos:definition "Jaar waarin het door de rechter in eerste aanleg afgedane feit wordt geteld."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7f88975a4141b8377afe61d47aa07e9ab0a4c5a564c45c9a8d03621e1a2e6fb7 ;
    skos:prefLabel "StatJaar"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157da a skos:Concept ;
    skos:definition "Door het Openbaar Ministerie afgedane strafzaken"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:c02d0260bee184f5a25b8febb7be369210bcda5fa99c12fbbdbc591b352c8f75 ;
    skos:prefLabel "Is strafzaak door het OM afgedaan?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157f7 a skos:Concept ;
    skos:definition "Periode waarin een zitting is vrijgegeven voor executie."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b9166415908afaa00b9dd08aea880cecd805db3627e42ea3874d6f517a55cc4c ;
    skos:prefLabel "Periode zitting vrijgegeven voor executie"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157f8 a skos:Concept ;
    skos:definition "De aard van de beslissing die een rechter in eerste aanleg in een strafzaak heeft genomen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:eb4abe1c1dc20375dd01766f5ecb2d11459cfebce40827da8c46d4a767e5e942 ;
    skos:prefLabel "Beslissing in zaak"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157f9 a skos:Concept ;
    skos:definition "Indicatie of er verzet is aangetekend tegen een vonnis."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:49b3da3af6a38c189107734096acb67f370f39713db999275e348533f93eb055 ;
    skos:prefLabel "Is vonnis een verzetvonnis?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157fa a skos:Concept ;
    skos:definition "De wijze waarop een uitnodiging ter terechtzitting is betekend."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:72ff55cd2a1e0bd37379281368942b310326bb6a7b0d29ed6ed725c8e04f205c ;
    skos:prefLabel "Betekening uitnodiging"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157fb a skos:Concept ;
    skos:definition "Is een verdachte ter terechtzitting is verschenen?"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cf51f08750765e4d249744fb1d8266a4369b040769f73de77f6e5d5705c36ba1 ;
    skos:prefLabel "Is verdachte verschenen ter zitting?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157fc a skos:Concept ;
    skos:definition "Indicatie of er sprake is van een vonnis op tegenspraak (contradictoir) of een vonnis bij afwezigheid van de verdachte (verstek)."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e6ada2074b4fa320f32ea623c8f1b3a6823a661de553e773fdba0ed4b9bbac7f ;
    skos:prefLabel "Contradictoir vonnis of verstekvonnis?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157fd a skos:Concept ;
    skos:definition "Periode waarin de eerste zitting in een strafzaak heeft plaatsgevonden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d37ad8384e093cfe6020fa8e98a3f3881ce5ab8d05ea0db0b60330108459961f ;
    skos:prefLabel "Periode van eerste zitting"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802157fe a skos:Concept ;
    skos:definition "Door de rechter in eerste aanleg afgedane strafzaken"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e2bd9e83dd97b1a5cbe3af2c9a0cb47f80b722ae4c00defe08ac552424628577 ;
    skos:prefLabel "Is de strafzaak door de rechter in eerste aanleg afgedaan?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215c81 a skos:Concept ;
    skos:definition "Een volgnummer om een persoon uniek te identificeren."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a2015b0799d9cb4bc5b8ffe03f89ceacde69875f3236315c598e1a096e9e9fc1 ;
    skos:prefLabel "Volgnummer uniciteit"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215c82 a skos:Concept ;
    skos:definition "De begindatum van een periode waarin de uniciteit van een persoon niet gewijzigd is."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e62423748f7b221460fa20bf03c9bf6494c8fe6e4ed9de78b5508ba2967768a7 ;
    skos:prefLabel "Begingeldigheid uniciteit"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215c83 a skos:Concept ;
    skos:definition "De einddatum van een periode waarin de uniciteit van een persoon niet gewijzigd is."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:327143d300681eecb3f262525c4fb5fcda59c6da2af451eeb7d455772670d2b5 ;
    skos:prefLabel "Eindgeldigheid uniciteit"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215ce7 a skos:Concept ;
    skos:definition "De ontwikkeling van de prijs van arbeid. Dit betreft de ontwikkeling van de loonkosten per gewerkt uur van werknemers, gecorrigeerd voor veranderingen in de werknemersstructuur."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:5a5123caf6f1b15f33bd2da14c277fb5deb02dce6556847cf20010d654189175 ;
    skos:prefLabel "Indexcijfer prijs van arbeid"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215ce8 a skos:Concept ;
    skos:definition "Procentuele mutatie van de loonkosten per gewerkt uur ten opzichte van dezelfde periode een jaar eerder."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2449174996d9fed3304a1e6426c1568aafd50fee54e057c78b5757ad28ebbdfa ;
    skos:prefLabel "Ontwikkeling loonkosten per gewerkt uur"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215ce9 a skos:Concept ;
    skos:definition "Procentuele mutatie van de prijsindex arbeid ten opzichte van dezelfde periode een jaar eerder."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:9e589645f7bf2d3cb7efbf4cff060dad9bf9489c2ef9ba26b8030bc88ca3c3df ;
    skos:prefLabel "Ontwikkeling prijsindex arbeid"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215cea a skos:Concept ;
    skos:definition "Het verschil tussen de ontwikkeling van de loonkosten per gewerkt uur en de prijs van arbeid."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:07738b667f53b3fa6ab5dafca7ba1483b5c0b57823d8ed9742e256d46b842b7d ;
    skos:prefLabel "Structuureffect van de loonkosten per gewerkt uur"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215f3b a skos:Concept ;
    skos:definition "Dit nummer identificeert een bibliotheek. Het nummer is dimensie- en betekenisloos."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a9abef0eb75f1451d4bf64c63c38e9421b495910607ebce641b12756057d3b29 ;
    skos:prefLabel "Bibliotheek-id"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215f3c a skos:Concept ;
    skos:definition "Naam van een bibliotheek"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e24535aca1a4cf7e9cde4801be3d200572e3219c675fc34960c614aecfafd8aa ;
    skos:prefLabel "Bibliotheeknaam"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080215f3d a skos:Concept ;
    skos:definition "Naam van een bibliotheekvestiging"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1e3c57cb1d223e0a6d3e004ad1b490ae18a85c21b60bb60e1411e73c8a295cc9 ;
    skos:prefLabel "Naam bibliotheekvestiging"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080216120 a skos:Concept ;
    skos:definition "Deze indicator geeft aan om welke dienstenstroom het gaat."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:6936b66b3dfa0fabd7bd1c7e47eb4105024300d931f3cd6a9d9db11c987dacc6 ;
    skos:prefLabel "Indicator Dienstenstroom"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080216122 a skos:Concept ;
    skos:definition "Het land van herkomst van een dienst bij de invoer van een dienst respectievelijk het land van bestemming van een dienst bij de uitvoer van een dienst."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:4a3d1c719f88521f17812b8cb9027be8515558c29f3ddbef9b617c544a055bf5 ;
    skos:prefLabel "Land van herkomst of bestemming van een dienst"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080216141 a skos:Concept ;
    skos:definition "Het peilingnummer van een interview"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b781af43e76565dfd1c4a7d73701b702b9411fdf04423fde3bcaff607a9cec7e ;
    skos:prefLabel "Peilingnummer interview"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080216143 a skos:Concept ;
    skos:definition "De bron waaruit een gebouw identificerend nummer is afgeleid."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b71d0a5566d2d827410aafcf9bcad89c0a119d279b0184d7d97e291143c17f95 ;
    skos:prefLabel "Indicator oorsprong gebouw identificerend nummer"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080216144 a skos:Concept ;
    skos:definition "Een gebouw identificerend nummer."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7733133bec65f89e21a9633310570e94f62c6be413bf391fddaa9dfbad3b0467 ;
    skos:prefLabel "Gebouw-id"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802161a5 a skos:Concept ;
    skos:definition "Heeft een persoon een opleiding in het buitenland gevolgd?"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a607e316c6760be19a43d6c1121111fd16808519bb4c506dddef604ecb78d54f ;
    skos:prefLabel "Opleiding in buitenland gevolgd?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e410802161a7 a skos:Concept ;
