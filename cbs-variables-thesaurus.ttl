    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108046e78b a skos:Concept ;
    skos:definition "Heeft een persoon lichaamsbeweging?"@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:52769b85394c9873fb3828451ac8d197b6c4365329a146c687257b9e8bdc45e2 ;
    skos:prefLabel "Lichaamsbeweging?"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047ab29 a skos:Concept ;
    skos:definition "Betalingen om niet die door de overheid of de Instellingen van de Europese Unie worden gedaan aan ingezeten producenten, met het doel de productieniveaus, de prijzen of de beloning van de productiefactoren te beïnvloeden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:07a93bc62054389aa2c8ac25931891f2ff5d470033afb8a68edbfb5bfbce7264 ;
    skos:prefLabel "Subsidies"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047ab2a a skos:Concept ;
    skos:definition "Bedrijfsopbrengsten die niet behoren tot de netto-omzet en subsidies."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d65cae5713c94637d9c9bab3132ed9b104d49841857d2b6961161888d437fa71 ;
    skos:prefLabel "Niet eerder genoemde bedrijfsopbrengsten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047ab2b a skos:Concept ;
    skos:definition "De totale kosten die zijn gemaakt om de bedrijfsopbrengsten te realiseren, te weten de inkoopwaarde van de omzet, de arbeidskosten, de afschrijvingen op vaste activa en de zogenaamde overige bedrijfskosten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:5c5839d9362969ec384425cb7d346ca457a78b1400afc3c49021ba1efa9ae7cb ;
    skos:prefLabel "Totaal bedrijfskosten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047ab2c a skos:Concept ;
    skos:definition "Totaal van de bruto lonen en salarissen van werknemers en de ten laste van de werkgevers komende sociale lasten en pensioenpremies, exclusief privéopbouw zoals lijfrente en koopsom."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2a4ca59e41da6833ae499bc9a11d189ce87dfd5dff4d5a7d968f8224757ec923 ;
    skos:prefLabel "Arbeidskosten_n03"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047d181 a skos:Concept ;
    skos:definition "De overige waardeveranderingen van immateriële en materiële vaste activa en bijzondere waardevermindering van vlottende activa. De overige waardeveranderingen betreffen niet de afschrijvingen op vaste activa."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d4cd3dbaf5a1be840849396e27ae3f297c04e849cf542141360964136bbca6f5 ;
    skos:prefLabel "Overige waardeveranderingen van activa"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047d182 a skos:Concept ;
    skos:definition "De overige personeelskosten, de kosten van energieverbruik, huisvesting, machines/installaties/inventaris en dergelijke, vervoermiddelen, verkoopkosten, communicatiekosten, kosten van dienstverlening door derden en overige bedrijfskosten die niet apart zijn gespecificeerd."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1a6339ecb1da4054af181128657a4a6f62cc17eee70d3e0f51412baec008f933 ;
    skos:prefLabel "Totaal overige bedrijfskosten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047d183 a skos:Concept ;
    skos:definition "Niet eerder genoemde bedrijfslasten naast arbeidskosten, afschrijvingen op vaste activa en andere personeelskosten. Dit betreft de kosten van grond- en hulpstoffen, kosten van uitbesteed werk, autokosten, huisvestingskosten (beide met aftrek van privégebruik), onderhoudskosten, verkoopkosten en overige bedrijfslasten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:e06c4f0547ad870f7839ad4aa3fdb702094f30d0e46682f9638c7faf16e135ae ;
    skos:prefLabel "Niet eerder genoemde bedrijfskosten"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108047d184 a skos:Concept ;
    skos:definition "De bedrijfsopbrengsten minus de bedrijfslasten."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:8ad6b8ba451c3b51b550fcc4358bfc77fcf87e34dbf106276b95fea35cb47f7b ;
    skos:prefLabel "Bedrijfsresultaat_n04"@nl ;
    skos:topConceptOf cbsVar: .

