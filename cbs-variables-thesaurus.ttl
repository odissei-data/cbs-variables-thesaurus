    skos:narrower cbsVar:c9aacc14c9deb3c5718b239ce81a00601f995d43018ce2c70d120548736efb28 ;
    skos:prefLabel "Verplaatsing-id"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080209da0 a skos:Concept ;
    skos:definition "Een chronologisch oplopende nummering van de verplaatsingen van een persoon."@nl ;
