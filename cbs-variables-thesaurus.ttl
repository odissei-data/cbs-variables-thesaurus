cbsVar:0b01e4108001db33 a skos:Concept ;
    skos:definition "Uitkeringen verzekeringen in verband met bedrijfsschade en schade aan goederen. Exclusief schade-uitkering op vaste activa."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:1c866432489438d22d31fdc7263550e0092596f8808345c5a16ad04e37726e2f,
