    skos:narrower cbsVar:9270ec498f031ab8036bf334a40954e2963e268ac485aaa1239d8af1be4aaee7 ;
    skos:prefLabel "Bank- en spaartegoeden van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108037361f a skos:Concept ;
    skos:definition "Totale waarde van obligaties en aandelen van een huishouden, exclusief aandelen aanmerkelijk belang."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:0a5ac1afbbef7c76ed6674a0306b776fa53a4394abe5265a4e627962d17d20fc ;
    skos:prefLabel "Effecten van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373620 a skos:Concept ;
    skos:definition "De totale waarde van de eigen woning en overig onroerend goed van een huishouden."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2566688ad98a2ef6971818b651c5fd1ad228f7e1584f38070b7e281055324625 ;
    skos:prefLabel "Waarde onroerend goed van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373621 a skos:Concept ;
    skos:definition "Waarde van een woning in eigendom van een huishouden en in gebruik als hoofdverblijf."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:8dbe590da15bc693ca5eac8ce7164b5e3558bab77715d7cc0e72cde0bc70665d ;
    skos:prefLabel "Waarde eigen woning van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373622 a skos:Concept ;
    skos:definition "Totale waarde van onroerend goed van een huishouden, exclusief de woning die als hoofdverblijf dient. Het gaat bijvoorbeeld om een tweede woning, een vakantiehuis, beleggingspanden en dergelijke."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:a3485ce310168c4d75497099a9717d1f4318e7fa66caa6d2880b1b2b5c779bdf ;
    skos:prefLabel "Overig onroerend goed van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373623 a skos:Concept ;
    skos:definition "Het saldo van bezittingen en schulden behorend tot een bedrijfs- of beroepsvermogen."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cd8ea9a75a60f449a6da4bf477ec445382b9df3df7d1d1ca8dbdd910036091b7 ;
    skos:prefLabel "Ondernemingsvermogen van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373624 a skos:Concept ;
    skos:definition "Waarde aanmerkelijk belang van een huishouden. Aanmerkelijk belang is een aandeel van tenminste 5 procent in het geplaatste aandelenkapitaal van een vennootschap."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:2a00e04c9b7cc761da32de2b714ec0706e1697503fa075c1502a117a06854d1b ;
    skos:prefLabel "Aanmerkelijk belang van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373625 a skos:Concept ;
    skos:definition "De totale waarde van overige bezittingen van een huishouden. Het gaat om bezittingen in de vorm van contant geld, roerende zaken verhuurd of in gebruik als belegging, trustvermogen en dergelijke, aandeel in onverdeelde boedel, vermogen belast met vruchtgebruik of beperkt eigendom."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d650cb489b46fd7ebbb900105a4b06dcfb9c2712a2684c117d696ee26cafcfe9 ;
    skos:prefLabel "Overige bezittingen van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373626 a skos:Concept ;
    skos:definition "Totale waarde aan schulden van een huishouden. De schulden betreffen de hypotheekschuld van de eigen woning, studieschulden en overige schulden zoals voor consumptieve doeleinden, de financieringen van aandelen, obligaties of rechten op periodieke uitkeringen, schulden voor de financiering van de tweede woning of ander onroerend goed."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:d7bfade66f6721e850092d06c809f7b7cf08533c9f18c0bf2df7230186804c15 ;
    skos:prefLabel "Schulden van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080373628 a skos:Concept ;
    skos:definition "Totale waarde aan studieschuld van een huishouden, volgens de Wet studiefinanciering en de Dienst Uitvoering Onderwijs."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:cd18b30a4fa5e46eadb09a8b71a90d24f1a9bf7f44e86005fcac721fa7d22c13 ;
    skos:prefLabel "Studieschuld van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108037363d a skos:Concept ;
    skos:definition "De waarde van de overige schulden van een huishouden betreffen schulden voor consumptieve doeleinden, de financieringen van aandelen, obligaties of rechten op periodieke uitkeringen, schulden voor de financiering van de tweede woning of ander onroerend goed."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:7d4e4cb1df40b2b77db9194eae89c074cfc5a91a595f456da8cb3a19babc184d ;
    skos:prefLabel "Overige schulden van een huishouden"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e4108037363e a skos:Concept ;
    skos:definition "Waarde van het totale vermogen van een huishouden, exclusief eigen woning en de daarop rustende hypotheekschuld."@nl ;
    skos:inScheme cbsVar: ;
    skos:narrower cbsVar:b0a3ff694e5760202255df60a850a64c3c76493b9c1e2f812fff6250422c2437 ;
    skos:prefLabel "Vermogen van een huishouden, exclusief eigen woning"@nl ;
    skos:topConceptOf cbsVar: .

cbsVar:0b01e41080375430 a skos:Concept ;
    skos:definition "Periode hoe lang een persoon werk wil."@nl ;
